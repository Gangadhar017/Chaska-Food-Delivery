{
  "name": "chaska",
  "private": true,
  "version": "1.0.0",
  "description": "Chaska - a full-stack food ordering and delivery web app (React, Express, SQLite)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "lint": "eslint .",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/anek-latin": "^5.2.5",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-query": "^5.90.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.4",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  }
}
