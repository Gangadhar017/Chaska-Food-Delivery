# Copy to .env.local for the web app, or set these in your shell for the server.
# Everything here is optional; the defaults work for local development.

# ── Web app (read by Vite at build time) ─────────────────────────────────────
# Where the API lives. Leave it unset to run the app without a server: the API
# then runs inside the browser and data is kept in localStorage.
# `npm run dev` sets this to /api for you.
VITE_API_URL=/api

# ── API server ───────────────────────────────────────────────────────────────
PORT=4000
# Folder for the SQLite database and the generated signing secret.
DATA_DIR=data
# Secret used to sign session tokens. If unset, one is generated and saved in DATA_DIR.
AUTH_SECRET=
# How many real seconds one "minute" of delivery time lasts. 60 is real time.
ORDER_SECONDS_PER_MINUTE=4
# Allow a web app on another origin to call this API, for example https://chaska.example.com
CORS_ORIGIN=
